{
  "name": "tasks-system",
  "version": "1.0.0",
  "description": "System for manage background tasks",
  "main": "main.js",
  "scripts": {
    "dev": "tsup --watch --onSuccess \"node dist/main.js\"",
    "build": "pnpm check && tsup",
    "start": "node dist/main.js",
    "job:test": "tsup && node dist/main.js --run-test-job",
    "format": "biome check --write .",
    "lint": "biome check . --fix",
    "check": "npm run lint && npm run format",
    "pm2:start": "pm2 start dist/main.js --name task-scheduler --env production --max-memory-restart 1G",
    "pm2:stop": "pm2 stop task-scheduler",
    "pm2:restart": "pm2 restart task-scheduler",
    "pm2:delete": "pm2 delete task-scheduler",
    "pm2:list": "pm2 list",
    "pm2:save": "pm2 save",
    "pm2:monit": "pm2 monit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@sentry/node": "^10.58.0",
    "better-sqlite3": "^12.10.0",
    "croner": "^10.0.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "mssql": "^12.5.5",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@swc/core": "^1.15.40",
    "@types/node": "^25.9.1",
    "tsup": "^8.5.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
